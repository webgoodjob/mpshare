<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CyberTrack - 即時定位與單次安全分享</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#0a0e17',
                            card: '#121824',
                            border: '#1f293d',
                            cyan: '#00f3ff',
                            green: '#39ff14',
                            red: '#ff2a6d',
                            yellow: '#ffe600',
                            text: '#e0e6ed',
                            subtext: '#8a99ad'
                        }
                    },
                    boxShadow: {
                        'neon-cyan': '0 0 15px rgba(0, 243, 255, 0.35)',
                        'neon-green': '0 0 15px rgba(57, 255, 20, 0.35)',
                        'neon-red': '0 0 15px rgba(255, 42, 109, 0.35)',
                    }
                }
            }
        }
    </script>

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            background-color: #0a0e17;
            color: #e0e6ed;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overflow-x: hidden;
        }

        #map {
            height: 100vh;
            width: 100vw;
            z-index: 1;
            background-color: #0a0e17;
        }

        /* 濾鏡調整：將淺色地圖轉換為極具質感的賽博朋克暗色調 */
        .dark-tiles-filter {
            filter: brightness(0.55) invert(1) contrast(2.2) hue-rotate(200deg) saturate(0.35) brightness(0.85);
        }

        /* 脈衝標籤動畫 */
        .user-location-marker {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .pulse-ring {
            position: absolute;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: rgba(0, 243, 255, 0.2);
            border: 2px solid #00f3ff;
            animation: pulse-animation 2s infinite;
        }

        .pulse-core {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background-color: #00f3ff;
            box-shadow: 0 0 12px #00f3ff, 0 0 24px #00f3ff;
            border: 2px solid #ffffff;
            z-index: 10;
        }

        .target-pulse-ring {
            position: absolute;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: rgba(57, 255, 20, 0.2);
            border: 2px solid #39ff14;
            animation: pulse-animation 2s infinite;
        }

        .target-pulse-core {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background-color: #39ff14;
            box-shadow: 0 0 12px #39ff14, 0 0 24px #39ff14;
            border: 2px solid #ffffff;
            z-index: 10;
        }

        @keyframes pulse-animation {
            0% { transform: scale(0.5); opacity: 1; }
            100% { transform: scale(2.2); opacity: 0; }
        }

        .leaflet-control-attribution {
            background: rgba(10, 14, 23, 0.85) !important;
            color: #8a99ad !important;
            font-size: 10px;
        }
        .leaflet-control-attribution a {
            color: #00f3ff !important;
        }
    </style>
</head>
<body class="relative min-h-screen flex flex-col justify-between select-none">

    <!-- 地圖圖層容器 -->
    <div id="map"></div>

    <!-- 頂部標題與狀態列 -->
    <header class="absolute top-4 left-4 right-4 z-10 flex items-center justify-between pointer-events-none">
        <div class="bg-cyber-card/90 backdrop-blur-md border border-cyber-border px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-3 pointer-events-auto">
            <div class="relative flex items-center justify-center">
                <span id="status-dot-ping" class="absolute inline-flex h-3 w-3 rounded-full bg-cyber-yellow opacity-75 animate-ping"></span>
                <span id="status-dot" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyber-yellow"></span>
            </div>
            <div>
                <h1 class="text-sm font-bold text-cyber-text tracking-wider flex items-center gap-1.5">
                    CYBER<span class="text-cyber-cyan">TRACK</span>
                    <span id="mode-badge" class="text-[10px] bg-cyber-cyan/10 text-cyber-cyan border border-cyber-cyan/30 px-1.5 py-0.5 rounded font-mono">定位主機</span>
                </h1>
                <p id="system-status-text" class="text-[11px] text-cyber-subtext">正在向瀏覽器請求 GPS 權限...</p>
            </div>
        </div>

        <!-- 功能控制按鈕 -->
        <div class="flex items-center gap-2 pointer-events-auto">
            <button id="recenter-btn" title="重新對焦我的位置" class="bg-cyber-card/90 hover:bg-cyber-border/80 text-cyber-cyan p-2.5 rounded-xl border border-cyber-border shadow-lg transition active:scale-95 flex items-center justify-center">
                <i data-lucide="crosshair" class="w-5 h-5"></i>
            </button>
        </div>
    </header>

    <!-- GPS 權限提醒提示框 -->
    <div id="gps-warning-banner" class="hidden absolute top-20 left-4 right-4 z-20 max-w-lg mx-auto bg-cyber-card/95 border border-cyber-yellow/60 rounded-2xl p-4 shadow-xl backdrop-blur-md pointer-events-auto">
        <div class="flex items-start gap-3">
            <div class="p-2 bg-cyber-yellow/10 border border-cyber-yellow/30 rounded-xl text-cyber-yellow shrink-0">
                <i data-lucide="alert-triangle" class="w-5 h-5"></i>
            </div>
            <div class="space-y-1.5 text-xs text-cyber-subtext">
                <h4 class="font-bold text-cyber-yellow text-sm">未能取得實體 GPS 定位</h4>
                <p id="gps-error-reason" class="text-cyber-text">瀏覽器阻止存取定位權限或目前位於非 HTTPS 安全連線環境。</p>
                <div class="bg-cyber-bg p-2.5 rounded-lg border border-cyber-border text-[11px] space-y-1 mt-2">
                    <p class="text-cyber-cyan font-semibold">💡 系統已自動啟用：模擬展示定位模式</p>
                    <p class="text-cyber-subtext">您仍可以正常測試「產生單次分享追蹤連結」以及即時地圖互動功能。</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 發起者儀表板 (Owner HUD) -->
    <div id="owner-hud" class="absolute bottom-4 left-4 right-4 z-10 flex flex-col gap-3 pointer-events-none max-w-lg mx-auto">
        <div class="bg-cyber-card/90 backdrop-blur-md border border-cyber-border p-4 rounded-2xl shadow-xl pointer-events-auto">
            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-cyber-bg/60 p-2.5 rounded-xl border border-cyber-border/50">
                    <div class="text-cyber-subtext mb-1 flex items-center gap-1">
                        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-cyber-cyan"></i> 緯度 / 經度
                    </div>
                    <div id="hud-coords" class="font-mono text-cyber-text font-medium text-sm truncate">--.------, --.------</div>
                </div>
                <div class="bg-cyber-bg/60 p-2.5 rounded-xl border border-cyber-border/50">
                    <div class="text-cyber-subtext mb-1 flex items-center gap-1">
                        <i data-lucide="disc" class="w-3.5 h-3.5 text-cyber-green"></i> 定位精確度
                    </div>
                    <div id="hud-accuracy" class="font-mono text-cyber-green font-medium text-sm">-- m</div>
                </div>
                <div class="bg-cyber-bg/60 p-2.5 rounded-xl border border-cyber-border/50">
                    <div class="text-cyber-subtext mb-1 flex items-center gap-1">
                        <i data-lucide="gauge" class="w-3.5 h-3.5 text-cyber-yellow"></i> 目前移動速度
                    </div>
                    <div id="hud-speed" class="font-mono text-cyber-text font-medium text-sm">0.0 km/h</div>
                </div>
                <div class="bg-cyber-bg/60 p-2.5 rounded-xl border border-cyber-border/50">
                    <div class="text-cyber-subtext mb-1 flex items-center gap-1">
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-cyber-subtext"></i> 最後更新時間
                    </div>
                    <div id="hud-updated" class="font-mono text-cyber-text font-medium text-sm">--:--:--</div>
                </div>
            </div>

            <div class="mt-3.5 pt-3 border-t border-cyber-border/60 flex flex-col gap-2">
                <button id="create-share-btn" class="w-full bg-cyber-cyan/10 hover:bg-cyber-cyan/20 border border-cyber-cyan/50 text-cyber-cyan font-bold py-2.5 px-4 rounded-xl transition shadow-neon-cyan flex items-center justify-center gap-2 text-sm active:scale-[0.98]">
                    <i data-lucide="share-2" class="w-4 h-4"></i>
                    <span>產生單次分享追蹤連結</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 追蹤者視角儀表板 (Viewer HUD) -->
    <div id="viewer-hud" class="hidden absolute bottom-4 left-4 right-4 z-10 flex-col gap-3 pointer-events-none max-w-lg mx-auto">
        <div class="bg-cyber-card/95 backdrop-blur-md border border-cyber-green/40 p-4 rounded-2xl shadow-xl pointer-events-auto">
            <div class="flex items-center justify-between mb-3 border-b border-cyber-border pb-2">
                <div class="flex items-center gap-2">
                    <i data-lucide="eye" class="w-4 h-4 text-cyber-green animate-pulse"></i>
                    <span class="text-xs font-bold text-cyber-green tracking-wider uppercase">單次授權追蹤模式</span>
                </div>
                <span class="text-[10px] bg-cyber-green/20 text-cyber-green border border-cyber-green/30 px-2 py-0.5 rounded-full font-mono">即時連線中</span>
            </div>
            
            <div class="grid grid-cols-2 gap-3 text-xs mb-3">
                <div class="bg-cyber-bg/60 p-2.5 rounded-xl border border-cyber-border/50">
                    <div class="text-cyber-subtext mb-1 flex items-center gap-1">
                        <i data-lucide="navigation" class="w-3.5 h-3.5 text-cyber-green"></i> 目標當前座標
                    </div>
                    <div id="viewer-coords" class="font-mono text-cyber-text font-medium text-sm truncate">同步中...</div>
                </div>
                <div class="bg-cyber-bg/60 p-2.5 rounded-xl border border-cyber-border/50">
                    <div class="text-cyber-subtext mb-1 flex items-center gap-1">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-cyber-cyan"></i> 資料更新時間
                    </div>
                    <div id="viewer-updated" class="font-mono text-cyber-text font-medium text-sm">--:--:--</div>
                </div>
            </div>

            <p class="text-[11px] text-cyber-subtext bg-cyber-bg/80 p-2.5 rounded-xl border border-cyber-border/40 flex items-start gap-2">
                <i data-lucide="shield-check" class="w-4 h-4 text-cyber-green shrink-0 mt-0.5"></i>
                <span>此連結已成功解鎖驗證。為保護隱私，該連結已經被關閉，其他人或重新整理頁面均無法再次讀取。</span>
            </p>
        </div>
    </div>

    <!-- 分享連結 Modal -->
    <div id="share-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-cyber-card border border-cyber-border rounded-2xl p-5 max-w-md w-full shadow-2xl relative">
            <button id="close-modal-btn" class="absolute top-4 right-4 text-cyber-subtext hover:text-cyber-text p-1">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-cyber-cyan/10 border border-cyber-cyan/30 rounded-xl text-cyber-cyan">
                    <i data-lucide="lock" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-cyber-text">單次安全連結已生成</h3>
                    <p class="text-xs text-cyber-subtext">僅限第一個點開連結的人觀看您的即時位置</p>
                </div>
            </div>

            <div class="space-y-3 mb-5">
                <div class="bg-cyber-bg p-3 rounded-xl border border-cyber-border flex items-center justify-between gap-2">
                    <input id="share-url-input" type="text" readonly class="bg-transparent font-mono text-xs text-cyber-cyan w-full outline-none select-all" value="" />
                    <button id="copy-url-btn" class="bg-cyber-cyan hover:bg-cyber-cyan/80 text-cyber-bg font-bold text-xs py-1.5 px-3 rounded-lg transition shrink-0 flex items-center gap-1">
                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        <span>複製連結</span>
                    </button>
                </div>

                <div class="p-3 bg-cyber-cyan/5 border border-cyber-cyan/20 rounded-xl space-y-1 text-xs text-cyber-subtext">
                    <div class="flex items-center gap-1.5 text-cyber-cyan font-semibold">
                        <i data-lucide="shield" class="w-4 h-4"></i> 單次存取原則：
                    </div>
                    <ul class="list-disc list-inside space-y-1 text-[11px] text-cyber-subtext pl-1">
                        <li>第一位使用者開啟該網址後，該 Token 隨即銷毀。</li>
                        <li>其他人或重複重新整理都會直接顯示「連結已失效」。</li>
                    </ul>
                </div>
            </div>

            <div class="flex gap-2">
                <button id="stop-share-btn" class="w-full bg-cyber-red/10 hover:bg-cyber-red/20 border border-cyber-red/40 text-cyber-red font-bold py-2.5 rounded-xl transition text-xs flex items-center justify-center gap-1.5">
                    <i data-lucide="stop-circle" class="w-4 h-4"></i>
                    <span>主動撤銷權限並關閉分享</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 連結已失效 Modal -->
    <div id="expired-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="bg-cyber-card border border-cyber-red/50 rounded-2xl p-6 max-w-sm w-full shadow-neon-red text-center space-y-4">
            <div class="w-14 h-14 bg-cyber-red/10 border border-cyber-red/30 rounded-full flex items-center justify-center mx-auto text-cyber-red">
                <i data-lucide="shield-x" class="w-8 h-8"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold text-cyber-text mb-1">分享連結已失效</h3>
                <p class="text-xs text-cyber-subtext leading-relaxed">
                    此「單次分享連結」先前已被開啟存取過或由建立者手動撤銷。基於安全保護機制已拒絕存取。
                </p>
            </div>
            <button onclick="window.location.href = window.location.pathname" class="w-full bg-cyber-card hover:bg-cyber-border border border-cyber-border text-cyber-text font-bold py-2.5 rounded-xl transition text-xs">
                回到我的定位主頁
            </button>
        </div>
    </div>

    <!-- Toast 提示訊息 -->
    <div id="toast" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-cyber-card/95 border border-cyber-cyan/50 text-cyber-cyan text-xs font-semibold px-4 py-2.5 rounded-xl shadow-neon-cyan opacity-0 transition-opacity duration-300 pointer-events-none flex items-center gap-2">
        <i data-lucide="info" class="w-4 h-4"></i>
        <span id="toast-msg">提示訊息</span>
    </div>

    <script>
        lucide.createIcons();

        let map, userMarker, targetMarker, accuracyCircle;
        let watchId = null;
        let activeShareToken = null;
        let broadcastChannel = null;
        let isViewerMode = false;
        let userPos = null;

        // 多重備援地圖 Tile Layers（解決 OpenStreetMap / CartoDB 403 Access Blocked 政策問題）
        const PRIMARY_TILE = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}';
        const FALLBACK_TILE = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';

        const hudCoords = document.getElementById('hud-coords');
        const hudAccuracy = document.getElementById('hud-accuracy');
        const hudSpeed = document.getElementById('hud-speed');
        const hudUpdated = document.getElementById('hud-updated');
        
        const viewerCoords = document.getElementById('viewer-coords');
        const viewerUpdated = document.getElementById('viewer-updated');
        
        const statusText = document.getElementById('system-status-text');
        const statusDot = document.getElementById('status-dot');
        const statusDotPing = document.getElementById('status-dot-ping');
        const modeBadge = document.getElementById('mode-badge');
        
        const ownerHud = document.getElementById('owner-hud');
        const viewerHud = document.getElementById('viewer-hud');
        const shareModal = document.getElementById('share-modal');
        const expiredModal = document.getElementById('expired-modal');
        const shareUrlInput = document.getElementById('share-url-input');
        const gpsWarningBanner = document.getElementById('gps-warning-banner');

        function showToast(message, duration = 3000) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            toastMsg.innerText = message;
            toast.classList.remove('opacity-0');
            toast.classList.add('opacity-100');
            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0');
            }, duration);
        }

        // 初始化 Leaflet 地圖並設定彈性備援機制
        function initMap() {
            const defaultPos = [25.033968, 121.564472]; // 預設：台北 101
            map = L.map('map', {
                center: defaultPos,
                zoom: 16,
                zoomControl: false
            });

            const mainLayer = L.tileLayer(PRIMARY_TILE, {
                attribution: '&copy; Esri, ArcGIS',
                maxZoom: 19,
                className: 'dark-tiles-filter'
            });

            mainLayer.on('tileerror', function() {
                console.warn('主要圖層載入受阻，自動切換至備援圖層...');
                map.removeLayer(mainLayer);
                L.tileLayer(FALLBACK_TILE, {
                    attribution: '&copy; CARTO, OpenStreetMap',
                    maxZoom: 19,
                    className: 'dark-tiles-filter'
                }).addTo(map);
            });

            mainLayer.addTo(map);
            L.control.zoom({ position: 'bottomright' }).addTo(map);
        }

        function createUserMarker(lat, lng) {
            const customIcon = L.divIcon({
                className: 'user-location-marker',
                html: `<div class="pulse-ring"></div><div class="pulse-core"></div>`,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });

            if (!userMarker) {
                userMarker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
            } else {
                userMarker.setLatLng([lat, lng]);
            }
        }

        function createTargetMarker(lat, lng) {
            const customIcon = L.divIcon({
                className: 'user-location-marker',
                html: `<div class="target-pulse-ring"></div><div class="target-pulse-core"></div>`,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });

            if (!targetMarker) {
                targetMarker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
            } else {
                targetMarker.setLatLng([lat, lng]);
            }
        }

        function updateAccuracyCircle(lat, lng, accuracy) {
            if (!accuracyCircle) {
                accuracyCircle = L.circle([lat, lng], {
                    radius: accuracy,
                    color: '#00f3ff',
                    fillColor: '#00f3ff',
                    fillOpacity: 0.08,
                    weight: 1.5,
                    dashArray: '4, 4'
                }).addTo(map);
            } else {
                accuracyCircle.setLatLng([lat, lng]);
                accuracyCircle.setRadius(accuracy);
            }
        }

        // 啟動 GPS 追蹤機制
        function startGeolocationTracking() {
            if (!navigator.geolocation) {
                gpsWarningBanner.classList.remove('hidden');
                useFallbackLocation();
                return;
            }

            statusText.innerText = "嘗試存取實體 GPS 中...";

            watchId = navigator.geolocation.watchPosition(
                (position) => {
                    gpsWarningBanner.classList.add('hidden');
                    const { latitude, longitude, accuracy, speed } = position.coords;
                    const timestamp = new Date(position.timestamp);

                    userPos = {
                        lat: latitude,
                        lng: longitude,
                        accuracy: accuracy,
                        speed: speed ? (speed * 3.6).toFixed(1) : "0.0",
                        updated: timestamp.toLocaleTimeString()
                    };

                    hudCoords.innerText = `${latitude.toFixed(6)}, ${longitude.toFixed(6)}`;
                    hudAccuracy.innerText = `${Math.round(accuracy)} m`;
                    hudSpeed.innerText = `${userPos.speed} km/h`;
                    hudUpdated.innerText = userPos.updated;

                    statusText.innerText = "高精度 GPS 定位中";
                    statusDot.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-cyber-green";
                    statusDotPing.className = "absolute inline-flex h-3 w-3 rounded-full bg-cyber-green opacity-75 animate-ping";

                    createUserMarker(latitude, longitude);
                    updateAccuracyCircle(latitude, longitude, accuracy);

                    if (!map._userCentered) {
                        map.setView([latitude, longitude], 17);
                        map._userCentered = true;
                    }

                    broadcastLocationUpdate();
                },
                (error) => {
                    gpsWarningBanner.classList.remove('hidden');
                    statusText.innerText = "已啟動模擬展示定位";
                    useFallbackLocation();
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        }

        // 定位失敗或無法存取時切換至模擬展示定位
        function useFallbackLocation() {
            if (window._fallbackStarted) return;
            window._fallbackStarted = true;

            let mockLat = 25.033968;
            let mockLng = 121.564472;

            statusDot.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-cyber-cyan";
            statusDotPing.className = "absolute inline-flex h-3 w-3 rounded-full bg-cyber-cyan opacity-75 animate-ping";

            setInterval(() => {
                mockLat += (Math.random() - 0.5) * 0.00012;
                mockLng += (Math.random() - 0.5) * 0.00012;
                const now = new Date().toLocaleTimeString();

                userPos = {
                    lat: mockLat,
                    lng: mockLng,
                    accuracy: 10,
                    speed: (Math.random() * 3 + 1).toFixed(1),
                    updated: now
                };

                hudCoords.innerText = `${mockLat.toFixed(6)}, ${mockLng.toFixed(6)}`;
                hudAccuracy.innerText = `10 m (模擬)`;
                hudSpeed.innerText = `${userPos.speed} km/h`;
                hudUpdated.innerText = now;

                createUserMarker(mockLat, mockLng);
                updateAccuracyCircle(mockLat, mockLng, 10);

                if (!map._userCentered) {
                    map.setView([mockLat, mockLng], 17);
                    map._userCentered = true;
                }

                broadcastLocationUpdate();
            }, 3000);
        }

        // 產生單次分享連結 (Single-Use Link Generation)
        function createSingleUseShareLink() {
            activeShareToken = 'tok_' + Math.random().toString(36).substring(2, 10) + Date.now().toString(36);

            const url = new URL(window.location.href);
            url.search = '';
            url.hash = `track?token=${activeShareToken}`;

            shareUrlInput.value = url.toString();
            shareModal.classList.remove('hidden');

            // 寫入本地記錄
            localStorage.setItem(`cyber_token_${activeShareToken}`, JSON.stringify({
                created: Date.now(),
                consumed: false,
                active: true
            }));

            setupBroadcastChannel(activeShareToken);
            showToast("單次安全連結已成功建立！");
        }

        function setupBroadcastChannel(token) {
            if (broadcastChannel) broadcastChannel.close();

            broadcastChannel = new BroadcastChannel(`cyber_channel_${token}`);

            broadcastChannel.onmessage = (event) => {
                const data = event.data;
                if (!data) return;

                if (data.type === 'REQUEST_ACCESS') {
                    const tokenDataStr = localStorage.getItem(`cyber_token_${token}`);
                    const tokenData = tokenDataStr ? JSON.parse(tokenDataStr) : null;

                    if (tokenData && tokenData.active && !tokenData.consumed) {
                        tokenData.consumed = true;
                        localStorage.setItem(`cyber_token_${token}`, JSON.stringify(tokenData));

                        broadcastChannel.postMessage({
                            type: 'ACCESS_GRANTED',
                            location: userPos
                        });

                        showToast("追蹤者已透過單次連結成功連線！");
                    } else {
                        broadcastChannel.postMessage({
                            type: 'ACCESS_DENIED',
                            reason: 'TOKEN_EXPIRED'
                        });
                    }
                }

                if (data.type === 'POLL_LOCATION') {
                    broadcastLocationUpdate();
                }
            };
        }

        function broadcastLocationUpdate() {
            if (broadcastChannel && userPos && activeShareToken) {
                broadcastChannel.postMessage({
                    type: 'LOCATION_UPDATE',
                    location: userPos
                });
            }
        }

        function stopSharing() {
            if (activeShareToken) {
                localStorage.removeItem(`cyber_token_${activeShareToken}`);
                if (broadcastChannel) {
                    broadcastChannel.postMessage({ type: 'SHARE_REVOKED' });
                    broadcastChannel.close();
                }
            }
            activeShareToken = null;
            shareModal.classList.add('hidden');
            showToast("已停止分享並銷毀連結權限");
        }

        // 追蹤檢視者視角初始化 (Viewer Mode)
        function initViewerMode(token) {
            isViewerMode = true;

            ownerHud.classList.add('hidden');
            viewerHud.classList.remove('hidden');
            modeBadge.innerText = "單次追蹤視角";
            modeBadge.className = "text-[10px] bg-cyber-green/10 text-cyber-green border border-cyber-green/30 px-1.5 py-0.5 rounded font-mono";

            statusText.innerText = "正在進行單次安全金鑰驗證...";

            broadcastChannel = new BroadcastChannel(`cyber_channel_${token}`);

            // 檢查 Token 是否已經被讀取過 (LocalStorage / Session Storage)
            const sessionConsumedKey = `cyber_consumed_${token}`;
            if (sessionStorage.getItem(sessionConsumedKey)) {
                showExpiredModal();
                return;
            }

            const tokenDataStr = localStorage.getItem(`cyber_token_${token}`);
            let tokenData = tokenDataStr ? JSON.parse(tokenDataStr) : null;

            if (tokenData && tokenData.consumed) {
                showExpiredModal();
                return;
            }

            broadcastChannel.onmessage = (event) => {
                const data = event.data;
                if (!data) return;

                if (data.type === 'ACCESS_GRANTED') {
                    sessionStorage.setItem(sessionConsumedKey, 'true');
                    statusText.innerText = "單次驗證通過 - 即時同步中";
                    if (data.location) updateViewerMap(data.location);
                } else if (data.type === 'ACCESS_DENIED' || data.type === 'SHARE_REVOKED') {
                    showExpiredModal();
                } else if (data.type === 'LOCATION_UPDATE') {
                    if (data.location) updateViewerMap(data.location);
                }
            };

            // 發送請求存取權限
            broadcastChannel.postMessage({ type: 'REQUEST_ACCESS' });

            setTimeout(() => {
                if (!viewerCoords.innerText.includes('.')) {
                    if (tokenData && tokenData.active && !tokenData.consumed) {
                        tokenData.consumed = true;
                        localStorage.setItem(`cyber_token_${token}`, JSON.stringify(tokenData));
                        sessionStorage.setItem(sessionConsumedKey, 'true');
                        statusText.innerText = "驗證成功 (讀取中)";
                    } else {
                        showExpiredModal();
                    }
                }
            }, 2000);
        }

        function updateViewerMap(pos) {
            viewerCoords.innerText = `${pos.lat.toFixed(6)}, ${pos.lng.toFixed(6)}`;
            viewerUpdated.innerText = pos.updated;

            createTargetMarker(pos.lat, pos.lng);

            if (!map._viewerCentered) {
                map.setView([pos.lat, pos.lng], 17);
                map._viewerCentered = true;
            } else {
                map.panTo([pos.lat, pos.lng]);
            }
        }

        function showExpiredModal() {
            expiredModal.classList.remove('hidden');
            if (broadcastChannel) broadcastChannel.close();
        }

        // 事件監聽綁定
        document.getElementById('recenter-btn').addEventListener('click', () => {
            if (isViewerMode && targetMarker) {
                map.setView(targetMarker.getLatLng(), 17);
                showToast("已對焦至目標點");
            } else if (userPos) {
                map.setView([userPos.lat, userPos.lng], 17);
                showToast("已對焦至我的位置");
            }
        });

        document.getElementById('create-share-btn').addEventListener('click', createSingleUseShareLink);
        document.getElementById('close-modal-btn').addEventListener('click', () => shareModal.classList.add('hidden'));
        document.getElementById('stop-share-btn').addEventListener('click', stopSharing);

        document.getElementById('copy-url-btn').addEventListener('click', () => {
            shareUrlInput.select();
            document.execCommand('copy');
            showToast("單次分享連結已複製！");
        });

        // 頁面啟動判斷
        window.addEventListener('load', () => {
            initMap();

            const hash = window.location.hash;
            let token = null;

            if (hash && hash.includes('track?token=')) {
                token = hash.split('track?token=')[1];
            }

            if (token) {
                initViewerMode(token);
            } else {
                startGeolocationTracking();
            }
        });
    </script>
</body>
</html>
